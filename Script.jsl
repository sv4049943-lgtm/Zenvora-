let cart=[];

function renderProducts(list=products){

  const grid=document.getElementById("productGrid");

  grid.innerHTML=list.map((p,index)=>`
    <div class="card">

      <div class="product-image">
        ${p[4]}
      </div>

      <h3>${p[0]}</h3>

      <small>${p[1]}</small>

      <p>
        <span class="price">₹${p[2]}</span>
        <span class="old">₹${p[3]}</span>
      </p>

      <button class="add" onclick="addToCart(${products.indexOf(p)})">
        Add to Cart
      </button>

    </div>
  `).join("");
}

function addToCart(index){

  cart.push(products[index]);

  document.getElementById("cartCount").innerText=cart.length;

  alert("Product added to cart!");
}

function showCart(){

  const box=document.getElementById("cartBox");
  const items=document.getElementById("cartItems");

  box.style.display="flex";

  if(cart.length===0){

    items.innerHTML="<p>Your cart is empty.</p>";

  }else{

    items.innerHTML=cart.map((p,i)=>`
      <div class="cart-item">

        <span>
          ${p[4]} ${p[0]}
        </span>

        <b>₹${p[2]}</b>

        <button onclick="removeCart(${i})">×</button>

      </div>
    `).join("");
  }

  let total=cart.reduce((sum,p)=>sum+p[2],0);

  document.getElementById("cartTotal").innerText=total;
}

function removeCart(index){

  cart.splice(index,1);

  document.getElementById("cartCount").innerText=cart.length;

  showCart();
}

function closeCart(){

  document.getElementById("cartBox").style.display="none";
}

function filterProducts(category){

  if(category==="All"){

    renderProducts(products);

  }else{

    renderProducts(
      products.filter(p=>p[1]===category)
    );
  }
}

function searchProducts(){

  const query=document
    .getElementById("search")
    .value
    .toLowerCase();

  const result=products.filter(p=>
    p[0].toLowerCase().includes(query) ||
    p[1].toLowerCase().includes(query)
  );

  renderProducts(result);
}

function checkout(){

  if(cart.length===0){

    alert("Your cart is empty.");

    return;
  }

  alert(
    "Checkout is ready for payment-gateway integration.\n\n" +
    "Next step: connect Razorpay/UPI and your supplier."
  );
}
